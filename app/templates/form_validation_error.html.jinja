{% for err in errors %}

    <!-- Use the HX-Trigger header to determin the swap -->
    {% set swap = "#{}".format(request.headers.get("HX-Trigger")) %}
    {% if err.loc %}
        {% set swap = "{} input[name='{}']".format(swap, err.loc[-1]) %}
    {% else %}
        {% set swap = swap ~ " input[type=submit]" %}
    {% endif %}

    <div hx-swap-oob="afterend:{{swap}}">
        <p class="err">
            {% if err.msg %}
                {{ err.msg }}
            {% else %}
                {{ err }}
            {% endif %}
        </p>
    </div>
{% endfor %}
