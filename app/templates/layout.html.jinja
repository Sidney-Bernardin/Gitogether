<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Gitogether{% endblock %}</title>

        <script src="{{ url_for("static", path="htmx.min.js") }}"></script>
        <script src="{{ url_for("static", path="main.js") }}" defer></script>

        <link rel="stylesheet" href="{{ url_for("static", path="layout.css") }}">

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/github.min.css" />
        <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/diff2html/bundles/css/diff2html.min.css" />
        <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/diff2html/bundles/js/diff2html-ui.min.js"></script>

        <style>
        form {
            display: flex;
            flex-direction: column;
            width: fit-content;
        }
        </style>

        <style>
        {% block style %}{% endblock %}
        </style>
    </head>
    <body>
        <nav>
            <a href="/">Home</a>
            {% if session %}
            <a href="{{ url_for("user_page", username=session.username) }}">{{ session.username }}</a>
                <button hx-get="/signout">Sign Out</button>
            {% else %}
                <a href="/signin">Sign In</a>
                <a href="/signup">Sign Up</a>
            {% endif %}
        </nav>
        <div class="content">
            {% block content %}{% endblock %}
        </div>
    </body>
</html>
