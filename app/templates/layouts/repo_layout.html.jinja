{% extends "layout.html.jinja" %}

{% block title %}{{ repo.reponame }}{% endblock %}

{% block head %}
    <link rel="stylesheet" href="{{ url_for("static", path="repo_layout.css") }}">
{% endblock %}

{% block content %}
    {% if not repo %}
        <p>Repo not found.</p>
    {% else %}
        <div class="side-bar">
            <h1>
                <a href="{{ url_for("user_page", username=username) }}">{{ username }}</a>
                /
                <a href="{{ url_for("repository_code_page", username=username, reponame=repo.reponame) }}">{{ repo.reponame }}</a>
            </h1>

                {% if repo.parent_id %}
                    ---
                    Fork of:
                    <a href="{{ url_for("repository_code_page", username=repo.parent_owner_username, reponame=repo.parent_reponame) }}">
                        {{ repo.parent_owner_username }} / {{ repo.parent_reponame }}
                    </a>
                    &nbsp;
                    <a href="{{ url_for("create_pull_request_page", username=repo.parent_owner_username, reponame=repo.parent_reponame).include_query_params(child=repo.repository_id) }}">
                        (Create Pull-Request)
                    </a>
                {% endif %}
        </div>

        <div class="branches">
            <p>branch: <strong>{{ commit_id }}</strong></p>
            <ul>
                {% for branch in repo_branches %}
                    <li>
                        <a href="{{ url_for("repository_code_page", username=username, reponame=repo.reponame, commit_id=branch) }}">
                            {{ branch }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>

        {% block repo_content %}{% endblock %}
    {% endif %}
{% endblock %}
