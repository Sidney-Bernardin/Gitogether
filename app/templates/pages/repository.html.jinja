{% extends "pages/layout.html.jinja" %}

{% block title %}{{ repo.reponame }}{% endblock %}

{% block content %}
<h1><a href="{{ url_for("user_page", username=username) }}">{{ username }}</a> / {{ repo.reponame }}</h1>

{% if session and session.username != username %}
<form id="fork" hx-patch="{{ url_for("fork_repository", repository_id=repo.repository_id) }}" hx-swap="none">
    <input type="text" name="reponame" value="{{ repo.reponame }}">
    <input type="submit">
</form>
{% endif %}

{% if not repo %}
    Repo not found.
{% elif not commit_id %}
    No commits.
{% elif not file %}
    File not found.
{% elif file.type_str == "tree" %}
    <ul>
        {% for f in file %}
            <a href="{{ url_for("repository_page", username=username, reponame=repo.reponame, commit_id=commit_id, path=file_path_sufix~f.name) }}">
                {{ f.name }}
            </a>
        {% endfor %}
    </ul>
{% elif file.type_str == "blob" %}
    {{ file.data }}
{% else %}
    
{% endif %}
{% endblock %}
