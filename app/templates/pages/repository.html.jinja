{% extends "pages/layout.html.jinja" %}

{% block title %}{{ repo.name }}{% endblock %}

{% block content %}
<h1><a href="{{ url_for("user_page", username=username) }}">{{ username }}</a> / {{ repo.name }}</h1>

{% if user and user.username != username %}
<form hx-patch="{{ url_for("create_repository_fork", repository_id=repo.repository_id) }}" hx-swap="none">
    <input type="text" name="name" value="{{ repo.name }}">
    <button type="submit">Fork</button>
</form>
{% endif %}

{% if not repo %}
    Repo not found.
{% elif not commit_id %}
    No commits.
{% elif not file %}
    File not found.
{% elif file.type_str == "tree" %}
    <ul>
        {% for f in file %}
            <a href="{{ url_for("repository_page", username=username, repo_name=repo.name, commit_id=commit_id, path=file_path_sufix~f.name) }}">
                {{ f.name }}
            </a>
        {% endfor %}
    </ul>
{% elif file.type_str == "blob" %}
    {{ file.data }}
{% else %}
    
{% endif %}
{% endblock %}
