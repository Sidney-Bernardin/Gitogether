{% extends "pages/layout.html.jinja" %}

{% block title %}{{ user.username }}{% endblock %}

{% block content %}
<h1>{{ user.username }}</h1>

{% if is_owner %}
<h2>Create Repository</h2>
<form hx-post="/repositories" hx-target="#repositories" hx-swap="beforeend">
    <label for="reponame">Name</label>
    <input type="text" name="reponame" placeholder="Name">

    <label for="public">Public</label>
    <input type="checkbox" name="public">
    <input type="submit">
</form>
{% endif %}

{% if user %}
<h2>Repositories</h2>
<ul id="repositories">
    {% for repo in repos %}
        <li>
            <a href="{{ url_for('repository_page', username=user.username, repo_name=repo.name) }}">{{ repo.name }}</a>
            {% if is_owner and not repo.public %}
                <span>(private)</span>
            {% endif %}
        </li>
    {% else %}
        <li>No repositories</li>
    {% endfor %}
</ul>

<h2>Other Repositories</h2>
<ul>
    {% for repo in contributed_repos %}
        <li>
            <a href="{{ url_for('repository_page', username=user.username, repo_name=repo.name) }}">{{ repo.name }}</a>
            {% if is_owner and not repo.public %}
                <span>(private)</span>
            {% endif %}
        </li>
    {% else %}
        <li>No repositories</li>
    {% endfor %}
</ul>
{% else %}
User not found.
{% endif %}
{% endblock %}
