{% extends "layout.html.jinja" %}

{% block title %}{{ user.username }}{% endblock %}

{% block content %}
<h1>{{ user.username }}</h1>

{% if is_owner %}
<h2>Create Repository</h2>
<form id="create" hx-post="/gitogether/repositories/" hx-swap="none">
    <label for="reponame">Name</label>
    <input type="text" name="reponame" placeholder="Name">

    <label for="private">Private</label>
    <input type="checkbox" name="private">

    <input type="submit">
</form>
{% endif %}

{% if user %}
<h2>Repositories</h2>
<ul id="repositories">
    {% for repo in repos %}
        <li>
            <a href="{{ url_for('repository_page', username=username, reponame=repo.reponame) }}">
                {{ repo.reponame }}
            </a>
            {% if is_owner and repo.private %}
                <span>(private)</span>
            {% endif %}
            {% if repo.parent_id %}
                <span>(fork)</span>
            {% endif %}
        </li>
    {% else %}
        <li>No repositories</li>
    {% endfor %}
</ul>

<h2>Other Repositories</h2>
<ul>
    {% for repo in contributed_repos %}
        <li>
            <a href="{{ url_for('repository_page', username=username, reponame=repo.reponame) }}">
                {{ repo.reponame }}
            </a>
        </li>
    {% else %}
        <li>No repositories</li>
    {% endfor %}
</ul>
{% else %}
User not found.
{% endif %}
{% endblock %}
