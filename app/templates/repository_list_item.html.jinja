{% macro repository(view, repo, is_owner) %}
    <li>
        <a href="{{ url_for('repository', username=username, repo_name=repo.name) }}">
            {{ repo.name }}
        </a>
        {% if is_owner and not repo.public %}
            <span>(private)</span>
        {% endif %}
    </li>
{% endmacro %}

{{ repository(view, repo, is_owner) }}
